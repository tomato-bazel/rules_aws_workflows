"""`cloudformation_up_interactive` — `bazel run` wrapper that drives
the cfn_console binary against a specific cloudformation_stack
target.

Usage:

```python
load("@rules_aws_workflows//aws/cloudformation:defs.bzl",
     "cloudformation_up_interactive")

cloudformation_up_interactive(
    name = "my_stack_up_i",
    stack = "//deploy/cloudformation:my_stack",   # any label producing a CFN JSON file
    stack_name = "my-stack",
    region = "us-east-1",
    capabilities = ["CAPABILITY_NAMED_IAM"],
)
```

`bazel run //deploy/cloudformation:my_stack_up_i` launches the
console: prompts for each Parameter via meridian, creates the
change set, shows the resource-change diff, asks for confirmation,
then executes and tails events.

No region, no parameter overrides, no static credentials in the
BUILD file — cfn_console reads creds from the standard AWS chain
at runtime and the region from --region (this rule's attr) or the
ambient AWS_REGION env var.
"""

def _cloudformation_up_interactive_impl(ctx):
    template_files = ctx.attr.stack[DefaultInfo].files.to_list()
    if len(template_files) != 1:
        fail("cloudformation_up_interactive: stack {} must produce exactly one file (got {})".format(
            ctx.attr.stack.label,
            len(template_files),
        ))
    template = template_files[0]
    cfn_console = ctx.executable._cfn_console
    stack_name = ctx.attr.stack_name or ctx.label.name
    args = [
        "--template",
        "${{RUNFILES_DIR}}/{}".format(template.short_path),
        "--stack-name",
        stack_name,
    ]
    if ctx.attr.region:
        args += ["--region", ctx.attr.region]
    for cap in ctx.attr.capabilities:
        args += ["--capability", cap]

    launcher = ctx.actions.declare_file(ctx.label.name + ".sh")
    ctx.actions.write(
        launcher,
        """#!/usr/bin/env bash
# @generated by cloudformation_up_interactive. DO NOT EDIT.
set -euo pipefail
if [[ -z "${{RUNFILES_DIR:-}}" ]]; then
    if [[ -d "$0.runfiles" ]]; then
        RUNFILES_DIR="$0.runfiles"
    elif [[ -d "${{BASH_SOURCE[0]}}.runfiles" ]]; then
        RUNFILES_DIR="${{BASH_SOURCE[0]}}.runfiles"
    else
        echo "cloudformation_up_interactive: cannot locate runfiles" >&2
        exit 1
    fi
fi
BIN="$RUNFILES_DIR/_main/{bin}"
if [[ ! -x "$BIN" ]]; then
    # Fallback when this rule is invoked from a different workspace —
    # the runfiles root may be the consumer's main, not _main.
    BIN="$(find "$RUNFILES_DIR" -name cfn_console -type f -perm -u+x 2>/dev/null | head -n1)"
fi
exec "$BIN" {args} "$@"
""".format(
            bin = cfn_console.short_path,
            args = " ".join(["'{}'".format(a) for a in args]),
        ),
        is_executable = True,
    )

    runfiles = ctx.runfiles(files = [template, cfn_console]).merge(
        ctx.attr._cfn_console[DefaultInfo].default_runfiles,
    )
    return [DefaultInfo(executable = launcher, runfiles = runfiles)]

cloudformation_up_interactive = rule(
    implementation = _cloudformation_up_interactive_impl,
    executable = True,
    doc = "Interactive CFN deploy driver. Wraps //cfn_console:cfn_console with a target's rendered template + a stack name. Prompts for Parameter values via meridian, runs CreateChangeSet → ExecuteChangeSet, tails events.",
    attrs = {
        "stack": attr.label(
            doc = "Any label whose DefaultInfo emits a single CFN JSON template (e.g. a `cloudformation_stack` target from rules_cloudformation).",
            allow_files = True,
            mandatory = True,
        ),
        "stack_name": attr.string(
            doc = "CFN stack name. Defaults to the rule's label name.",
        ),
        "region": attr.string(
            doc = "AWS region. If unset, cfn_console resolves it from the AWS config / AWS_REGION env var.",
        ),
        "capabilities": attr.string_list(
            doc = "CFN capabilities (`CAPABILITY_IAM`, `CAPABILITY_NAMED_IAM`, `CAPABILITY_AUTO_EXPAND`).",
        ),
        "_cfn_console": attr.label(
            default = "//cfn_console:cfn_console",
            executable = True,
            cfg = "target",
        ),
    },
)
