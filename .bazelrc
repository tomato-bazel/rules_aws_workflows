# Needed because this module and our `meridian` dep both define a
# `@crates` universe via `use_extension`. The isolated form
# disambiguates them — see MODULE.bazel.
common --experimental_isolated_extension_usages

# Premium registry first — meridian only lives there. Public
# fastverk registry second (for rules_cloudformation, etc.). BCR
# last as fallback.

# Forward `gh auth token` as a Bearer header for github.com fetches
# (private meridian + private fastverk-org tarballs from the premium
# registry). Without this, `bazel build` 404s on the private repos.
