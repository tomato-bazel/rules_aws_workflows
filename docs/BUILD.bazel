"""API reference for the public rules, generated by stardoc.

Regenerate the checked-in copy after changing a rule's docstrings:

    bazel run //docs:update

`bazel test //docs:defs_md_test` fails when `defs.md` is stale.
"""

load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@stardoc//stardoc:stardoc.bzl", "stardoc")

stardoc(
    name = "defs_md_gen",
    out = "defs_gen.md",
    input = "//aws/cloudformation:defs.bzl",
    deps = ["//aws/cloudformation:defs_bzl"],
)

diff_test(
    name = "defs_md_test",
    size = "small",
    failure_message = "docs/defs.md is stale; run `bazel run //docs:update`.",
    file1 = ":defs_md_gen",
    file2 = "defs.md",
)

write_file(
    name = "gen_update",
    out = "update.sh",
    content = [
        "#!/usr/bin/env bash",
        "set -euo pipefail",
        "cp -fv \"$1\" \"$BUILD_WORKSPACE_DIRECTORY/docs/defs.md\"",
    ],
    is_executable = True,
)

sh_binary(
    name = "update",
    srcs = ["update.sh"],
    args = ["$(rootpath :defs_md_gen)"],
    data = [":defs_md_gen"],
)
